---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import FoodCard from '../components/FoodCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import site from '../config/site.js';
import { orderAction } from '../lib/order.js';
import { href } from '../lib/url.js';
import { videoFor } from '../lib/media.js';
import { itemsByCategory, getItem } from '../data/menu.js';
import { craftChapters } from '../data/craft.js';
import { posts } from '../data/journal.js';

const order = orderAction();
const biryanis = itemsByCategory('biryani');
const featuredDrinks = itemsByCategory('drinks').filter((d) => d.featured);
const craftPreview = craftChapters.slice(0, 3);

// Hero slider: three slides, biryani, curry, tea and lassi.
const heroSlides = [
  { video: 'hero-loop', caption: 'Biryani' },
  { video: 'curry-simmer', caption: 'Curry' },
  { video: 'malai-tea-pour', caption: 'Tea and lassi' },
];
// On the launch menu: one biryani, one curry, one drink.
const notable = [getItem('lamb-biryani'), getItem('chicken-desi'), getItem('pistachio-badam-milk')].filter(Boolean);
const journalPosts = posts.slice(0, 2);

const pageTitle = 'Bengali Biryani & Desi Restaurant in Canada';
const pageDescription =
  `${site.name} is a Bengali restaurant in Canada serving dum-cooked biryani, slow-simmered desi curries, chicken korma, and traditional teas and lassis. Big flavour, no ordinary biryani.`;
---
<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- ── 1. Hero slider ────────────────────────────────────────────────── -->
  <section class="hero hero--slider" aria-label="Welcome" data-hero>
    <div class="hero__media">
      {heroSlides.map((s, i) => {
        const v = videoFor(s.video);
        return (
          <div class="hslide" data-hslide {...(i === 0 ? { 'data-active': 'true' } : {})}>
            <video
              class="hslide__video"
              muted loop playsinline preload="none"
              poster={v.poster}
              data-src={v.src}
              {...(i === 0 ? { 'data-eager': 'true' } : {})}
              aria-hidden="true"
            ></video>
          </div>
        );
      })}
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="container container--wide hero__inner">
      <div class="hero__content">
        <p class="hero__chip"><span class="chip-soon">Coming soon</span> Open 11 AM to 2 AM</p>
        <h1 class="display-hero" data-reveal style="--reveal-delay:120ms">
          Rooted in Bengal.<br /><span class="serif-i gold">Built for Canada.</span><br />Made for every craving.
        </h1>
        <p class="lede" data-reveal style="--reveal-delay:240ms; color: var(--text-faint); font-size: var(--fs-body);">
          Creating magical flavours in the simplest dishes of life.
        </p>
        <div class="hero__cta" data-reveal style="--reveal-delay:360ms">
          <a class="btn btn--gold" href="#opening-list" data-open-panel="opening-list">Join the opening list</a>
          <a class="btn btn--ghost" href={href('/menu/')}>See the menu</a>
        </div>
      </div>
    </div>

    <div class="hero__sliderui" aria-label="Slideshow controls">
      <button class="hslide__nav" type="button" data-hprev aria-label="Previous slide">&lsaquo;</button>
      <span class="hslide__count"><b data-hindex>01</b> / {String(heroSlides.length).padStart(2, '0')}</span>
      <span class="hslide__caption" data-hcaption aria-live="polite">{heroSlides[0].caption}</span>
      <button class="hslide__pause" type="button" data-hpause aria-pressed="false">Pause</button>
      <button class="hslide__nav" type="button" data-hnext aria-label="Next slide">&rsaquo;</button>
    </div>

    <span class="hero__scrollcue" aria-hidden="true">Scroll</span>
  </section>

  <!-- ── 1b. On the launch menu (where to start) ───────────────────────── -->
  <section class="section" aria-label="On the launch menu">
    <div class="container">
      <SectionHeading kicker="Where to start" title="On the launch menu" lede="A short menu on purpose. Here is where to start." />
      <div class="grid grid-3" style="margin-top: var(--space-7)">
        {notable.map((item, i) => (
          <article class="ncard" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <a class="ncard__media frame frame--tall" href={href(`/menu/${item.slug}/`)} aria-label={item.name}>
              <Picture name={item.image} alt={item.alt} sizes="(min-width: 900px) 30vw, 100vw" />
            </a>
            <div class="ncard__text">
              <h3 class="title-1" style="font-size: 1.3rem"><a class="link-quiet" href={href(`/menu/${item.slug}/`)}>{item.name}</a></h3>
              <p style="color: var(--text-soft); font-size: var(--fs-small)">{item.short}</p>
            </div>
          </article>
        ))}
      </div>
      <p style="margin-top: var(--space-6)" data-reveal>
        <a class="btn btn--ghost" href={href('/menu/')}>View the menu <span class="btn__arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ── 2. Brand-proof strip ──────────────────────────────────────────── -->
  <section class="proof" aria-label="What we care about">
    <div class="container proof__row">
      <div class="proof__item" data-reveal>
        <svg viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M15 3v24M15 8c-4 0-7-2.5-7-5M15 8c4 0 7-2.5 7-5M15 15c-5 0-9-3-9-6.5M15 15c5 0 9-3 9-6.5M15 22c-6 0-11-3.5-11-8M15 22c6 0 11-3.5 11-8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <strong>Spices ground fresh</strong>
        <span>Whole spices ground fresh keep oils that ground powder loses</span>
      </div>
      <div class="proof__item" data-reveal style="--reveal-delay:120ms">
        <svg viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M4 13h22v3a11 11 0 0 1-22 0v-3Z" stroke="currentColor" stroke-width="1.4"/><path d="M8 13c0-4 3-7 7-7s7 3 7 7M11 3c0 1.5 1.5 2 2 3.5M17 3c0 1.5 1.5 2 2 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <strong>Sealed on dum</strong>
        <span>A dough seal traps the steam so rice and meat finish in their own heat</span>
      </div>
      <div class="proof__item" data-reveal style="--reveal-delay:240ms">
        <svg viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M7 4h16l-2 9H9L7 4ZM9 13c0 6 2 9 6 13 4-4 6-7 6-13" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        <strong>Poured by hand</strong>
        <span>Tea pulled from a height for froth, lassi poured thick and cold</span>
      </div>
    </div>
  </section>

  <!-- ── 3. Featured biryanis ──────────────────────────────────────────── -->
  <section class="section texture-leaf grain">
    <div class="container">
      <SectionHeading
        kicker="Signature"
        title="Biryani, layered and sealed"
        lede="Rice layered with saffron, fried onion and slow-cooked meat. Sealed, then left on gentle heat until the lid is worth lifting."
      />
      <div class="grid grid-2" style="margin-top: var(--space-7)">
        {biryanis.map((item, i) => <FoodCard item={item} revealDelay={i * 120} />)}
      </div>
      <p style="margin-top: var(--space-6)" data-reveal>
        <a class="link-quiet" href={href('/menu/')}>See the full menu <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ── 4. The Art of the Craft ───────────────────────────────────────── -->
  <section class="section section--light texture-leaf--light">
    <div class="container">
      <div class="split on-light">
        <div class="split__text" data-reveal="left">
          <p class="kicker">The craft</p>
          <h2 class="display-1" style="margin-top: var(--space-4)">Eight steps,<br /><span class="serif-i">one pot</span></h2>
          <p class="lede" style="margin-top: var(--space-4)">
            Spices ground fresh, onions fried to bronze, saffron crumbled by the thread,
            and a dough seal that keeps the steam in. That is how a proper dum biryani is built.
          </p>
          <p style="margin-top: var(--space-6)"><a class="btn btn--ghost-dark" href={href('/the-craft/')}>See how it is made <span class="btn__arrow" aria-hidden="true">→</span></a></p>
        </div>
        <div class="split__media" data-reveal="right">
          <div class="grid grid-3" style="gap: var(--space-4)">
            {craftPreview.map((ch, i) => (
              <div class="frame" style={`aspect-ratio: 1; ${i === 1 ? 'transform: translateY(22px);' : ''}`}>
                <Picture name={ch.image} alt={ch.alt} sizes="(min-width: 1024px) 20vw, 33vw" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 5. The table / experience ─────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__media" data-reveal="left">
          <div class="frame frame--wide corner-ornament">
            <Picture
              name="hero-table-spread"
              alt="A table spread at Osthir Flavours, a bowl of biryani, a bowl of creamy korma, spiced tea and mango lassi on brass trays with emerald linen."
              sizes="(min-width: 1024px) 55vw, 100vw"
            />
          </div>
        </div>
        <div class="split__text" data-reveal="right">
          <p class="kicker">The Table</p>
          <h2 class="display-1" style="margin-top: var(--space-4)">Made for the middle<br /><span class="serif-i gold">of the table</span></h2>
          <p class="lede" style="margin-top: var(--space-4)">
            Order a bowl each, or one big one for the whole table. Biryani is built to be shared.
          </p>
          <div class="hero__cta" style="margin-top: var(--space-6)">
            <a class="btn btn--gold" href={order.href} {...(order.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              {order.label} <span class="btn__arrow" aria-hidden="true">→</span>
            </a>
            <a class="btn btn--ghost" href={href('/locations/')}>Opening soon</a>
          </div>
          {!order.connected && (
            <p style="font-size: var(--fs-small); color: var(--text-faint); margin-top: var(--space-4)">
              Ordering opens with the restaurant.
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ── 6. Featured drinks ────────────────────────────────────────────── -->
  <section class="section texture-leaf grain" style="background: linear-gradient(180deg, rgba(6,76,57,.35), transparent 40%);">
    <div class="container">
      <SectionHeading
        kicker="The pours"
        title="Teas and lassis"
        lede="Saffron tea steeped amber, mint torn fresh. Lassi on the thick side, mango or plain. Badam milk with pistachio, served cold."
      />
      <div class="grid grid-3" style="margin-top: var(--space-7)">
        {featuredDrinks.map((item, i) => <FoodCard item={item} revealDelay={i * 120} />)}
      </div>
      <p style="margin-top: var(--space-6)" data-reveal>
        <a class="link-quiet" href={href('/drinks/')}>All drinks <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ── 7. Brand story preview ────────────────────────────────────────── -->
  <section class="section">
    <div class="container container--narrow" style="text-align: center; display: grid; gap: var(--space-5); justify-items: center;">
      <p class="kicker kicker--bare" data-reveal>Our Story</p>
      <h2 class="display-1" data-reveal style="--reveal-delay:100ms">
        Simple dishes are not<br /><span class="serif-i gold">simple to make well</span>
      </h2>
      <p class="lede" data-reveal style="--reveal-delay:200ms; margin-inline: auto;">
        {site.name} began with a small conviction: the humblest plate (rice, spice, a pot, a flame)
        holds the most magic when every small step is done properly.
      </p>
      <p data-reveal style="--reveal-delay:300ms">
        <a class="link-quiet" href={href('/our-story/')}>Read our story <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ── Catering and events band ──────────────────────────────────────── -->
  <section class="section" aria-label="Catering and events">
    <div class="container cta-band">
      <p class="kicker kicker--bare" data-reveal>Catering and events</p>
      <h2 class="display-1" data-reveal style="--reveal-delay:100ms">Feed a room, <span class="serif-i gold">not just a table</span></h2>
      <p class="lede" data-reveal style="--reveal-delay:160ms; margin-inline: auto; max-width: 52ch">
        Biryani travels well and desi spreads are built for a crowd. Tell us about your event and we will plan the menu with you.
      </p>
      <div class="hero__cta" style="justify-content:center; --reveal-delay:220ms" data-reveal>
        <a class="btn btn--gold" href={href('/catering/')}>Plan an event <span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ── Gift cards band ───────────────────────────────────────────────── -->
  <section class="section texture-leaf grain" aria-label="Gift cards" style="border-top: 1px solid var(--line)">
    <div class="container cta-band">
      <p class="kicker kicker--bare" data-reveal>Gift cards</p>
      <h2 class="display-1" data-reveal style="--reveal-delay:100ms">Gift cards are <span class="serif-i gold">coming</span></h2>
      <p class="lede" data-reveal style="--reveal-delay:160ms; margin-inline: auto; max-width: 48ch">
        We are setting them up for the launch. Join the list and you will know the day they go on sale.
      </p>
      <div class="hero__cta" style="justify-content:center; --reveal-delay:220ms" data-reveal>
        <a class="btn btn--gold" href="#opening-list" data-open-panel="opening-list">Join the opening list</a>
      </div>
    </div>
  </section>

  <!-- ── From the journal ──────────────────────────────────────────────── -->
  <section class="section" aria-label="From the journal">
    <div class="container">
      <SectionHeading kicker="Journal" title="From the journal" lede="Short notes on how the food is made and why it tastes the way it does." />
      <div class="grid grid-2" style="margin-top: var(--space-7)">
        {journalPosts.map((p, i) => (
          <article class="jcard" data-reveal style={`--reveal-delay:${i * 100}ms`}>
            <a class="jcard__media frame" href={href(`/journal/${p.slug}/`)} aria-label={p.title}>
              <Picture name={p.image} alt={p.alt} sizes="(min-width: 900px) 45vw, 100vw" />
            </a>
            <div class="jcard__text">
              <h3 class="title-1" style="font-size: 1.25rem"><a class="link-quiet" href={href(`/journal/${p.slug}/`)}>{p.title}</a></h3>
              <p style="color: var(--text-soft); font-size: var(--fs-small)">{p.excerpt}</p>
            </div>
          </article>
        ))}
      </div>
      <p style="margin-top: var(--space-6)" data-reveal>
        <a class="link-quiet" href={href('/journal/')}>More from the journal <span aria-hidden="true">&rsaquo;</span></a>
      </p>
    </div>
  </section>

  <!-- ── Keep updated (no social profiles yet, so show the list) ────────── -->
  <section class="section texture-leaf grain" aria-label="Keep updated" style="border-top: 1px solid var(--line)">
    <div class="container cta-band">
      <p class="kicker kicker--bare" data-reveal>Keep updated</p>
      <h2 class="title-1" data-reveal style="--reveal-delay:100ms">Be first to know when we open</h2>
      <div class="hero__cta" style="justify-content:center; --reveal-delay:160ms" data-reveal>
        <a class="btn btn--gold" href="#opening-list" data-open-panel="opening-list">Join the opening list</a>
      </div>
    </div>
  </section>

  <!-- ── 8. Visit CTA band ─────────────────────────────────────────────── -->
  <section class="section texture-leaf grain" style="border-top: 1px solid var(--line);">
    <div class="container cta-band">
      <p class="kicker kicker--bare" data-reveal>Opening soon</p>
      <h2 class="display-1" data-reveal style="--reveal-delay:100ms">The pots go on <span class="serif-i gold">soon</span></h2>
      <div class="hero__cta" style="justify-content:center; --reveal-delay:200ms" data-reveal>
        <a class="btn btn--gold" href={href('/menu/')}>See the menu <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={href('/contact/')}>Get in touch</a>
      </div>
    </div>
  </section>

  <script>
    // Hero slider: loads only the active video (good for LCP), autoplays on a
    // slow timer that pauses on hover, focus, the pause button, and reduced
    // motion. Keyboard arrows and touch swipe both move it.
    const hero = document.querySelector('[data-hero]');
    if (hero) {
      const slides = [...hero.querySelectorAll('[data-hslide]')];
      const captions = ['Biryani', 'Curry', 'Tea and lassi'];
      const idxEl = hero.querySelector('[data-hindex]');
      const capEl = hero.querySelector('[data-hcaption]');
      const pauseBtn = hero.querySelector('[data-hpause]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let cur = 0, timer = null, paused = reduced;

      function loadVideo(slide) {
        if (reduced) return; // poster only under reduced motion
        const v = slide.querySelector('video');
        if (v && v.dataset.src && !v.src) { v.src = v.dataset.src; }
        v?.play().catch(() => {});
      }
      function show(i) {
        i = (i + slides.length) % slides.length;
        slides.forEach((s, n) => {
          const on = n === i;
          if (on) { s.setAttribute('data-active', 'true'); loadVideo(s); }
          else { s.removeAttribute('data-active'); s.querySelector('video')?.pause(); }
        });
        cur = i;
        if (idxEl) idxEl.textContent = String(i + 1).padStart(2, '0');
        if (capEl) capEl.textContent = captions[i] || '';
      }
      const next = () => show(cur + 1);
      const prev = () => show(cur - 1);
      function start() { if (paused || reduced) return; stop(); timer = window.setInterval(next, 7000); }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      const restart = () => { stop(); start(); };

      loadVideo(slides[0]);
      hero.querySelector('[data-hnext]')?.addEventListener('click', () => { next(); restart(); });
      hero.querySelector('[data-hprev]')?.addEventListener('click', () => { prev(); restart(); });
      pauseBtn?.addEventListener('click', () => {
        paused = !paused;
        pauseBtn.setAttribute('aria-pressed', String(paused));
        pauseBtn.textContent = paused ? 'Play' : 'Pause';
        paused ? stop() : start();
      });
      hero.addEventListener('mouseenter', stop);
      hero.addEventListener('mouseleave', () => { if (!paused) start(); });
      hero.addEventListener('focusin', stop);
      hero.addEventListener('focusout', () => { if (!paused) start(); });
      hero.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { next(); restart(); }
        else if (e.key === 'ArrowLeft') { prev(); restart(); }
      });
      let sx = 0;
      hero.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; }, { passive: true });
      hero.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - sx;
        if (Math.abs(dx) > 40) { dx < 0 ? next() : prev(); restart(); }
      }, { passive: true });

      if (!reduced) start();
    }
  </script>
</BaseLayout>
