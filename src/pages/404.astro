---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import { href } from '../lib/url.js';
---
<BaseLayout
  title="Page Not Found"
  description="This page has wandered off the table. Find your way back to the Osthir Flavours menu, story or homepage."
  noindex
>
  <section class="section texture-leaf" style="padding-top: calc(var(--header-h) + var(--space-9)); min-height: 70svh;">
    <div class="container split" style="align-items:center">
      <div class="split__text">
        <p class="kicker" data-reveal>Error 404</p>
        <h1 class="display-hero" data-reveal style="--reveal-delay:100ms">This Plate Is<br /><span class="serif-i gold">Off the Menu</span></h1>
        <p class="lede" data-reveal style="--reveal-delay:200ms">
          The page you were looking for has been cleared away. The kitchen, however,
          is very much open.
        </p>
        <div class="hero__cta" data-reveal style="--reveal-delay:300ms">
          <a class="btn btn--gold" href={href('/')}>Back to Home <span class="btn__arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href={href('/menu/')}>See the Menu</a>
        </div>
      </div>
      <div class="split__media" data-reveal="right">
        <div class="frame frame--wide corner-ornament">
          <Picture name="lamb-biryani" alt="A steaming bowl of lamb biryani with saffron rice, lemon and mint" sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
