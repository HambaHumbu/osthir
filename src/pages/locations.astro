---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import site from '../config/site.js';
import { breadcrumbJsonLd } from '../lib/seo.js';
import { orderAction } from '../lib/order.js';
import { href } from '../lib/url.js';

const order = orderAction();
const { location, contact } = site;
const hasAddress = Boolean(location.addressLines);
const hasHours = Boolean(location.openingHours);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Visit Us', path: '/locations/' },
];
---
<BaseLayout
  title="Visit"
  description="Osthir Flavours is opening soon in Canada. Planned hours are 11 AM to 2 AM, every day. Here is how to reach us before then."
  jsonld={[breadcrumbJsonLd(crumbs)]}
>
  <header class="page-hero texture-leaf">
    <div class="container page-hero__inner">
      <Breadcrumbs items={crumbs} />
      <p class="kicker" data-reveal>Visit</p>
      <h1 class="display-hero" data-reveal style="--reveal-delay:100ms">Find <span class="serif-i gold">the table</span></h1>
      <p class="lede" data-reveal style="--reveal-delay:200ms">
        We are opening soon in Canada. Here are the planned hours and the ways to reach us before then.
      </p>
    </div>
  </header>

  <section class="section--tight section">
    <div class="container">
      <div class="grid grid-3">
        <div data-reveal style="border: 1px solid var(--line); border-radius: var(--radius-l); padding: var(--space-6); display: grid; gap: var(--space-3); align-content: start;">
          <p class="kicker kicker--bare">Address</p>
          {hasAddress ? (
            <address style="font-style: normal; color: var(--text-soft)">
              {location.addressLines.map((line) => <span>{line}<br /></span>)}
              {location.city && <span>{location.city}{location.postcode ? `, ${location.postcode}` : ''}</span>}
              {location.country && <><br /><span>{location.country}</span></>}
            </address>
          ) : (
            <p style="color: var(--text-soft); font-size: var(--fs-small)">
              Opening soon in Canada. The exact address will be announced shortly.
              Planned hours are listed here beside this.
            </p>
          )}
          {location.directionsUrl && (
            <p><a class="link-quiet" href={location.directionsUrl} target="_blank" rel="noopener noreferrer">Get directions ↗</a></p>
          )}
        </div>

        <div data-reveal style="--reveal-delay:120ms; border: 1px solid var(--line); border-radius: var(--radius-l); padding: var(--space-6); display: grid; gap: var(--space-3); align-content: start;">
          <p class="kicker kicker--bare">Opening hours</p>
          {hasHours ? (
            <ul style="list-style: none; padding: 0; color: var(--text-soft); font-size: var(--fs-small); display: grid; gap: var(--space-2)">
              {location.openingHours.map((h) => <li style="display:flex;justify-content:space-between;gap:var(--space-4)"><span>{h.days}</span><span>{h.hours}</span></li>)}
            </ul>
          ) : (
            <p style="color: var(--text-soft); font-size: var(--fs-small)">
              Hours will be confirmed closer to opening.
            </p>
          )}
          <p style="color: var(--text-faint); font-size: var(--fs-micro)">Planned hours. Confirmed at opening.</p>
        </div>

        <div data-reveal style="--reveal-delay:240ms; border: 1px solid var(--line); border-radius: var(--radius-l); padding: var(--space-6); display: grid; gap: var(--space-3); align-content: start;">
          <p class="kicker kicker--bare">Contact</p>
          {contact.phone && <p><a class="link-quiet" href={`tel:${contact.phoneHref}`}>{contact.phone}</a></p>}
          {contact.email && <p><a class="link-quiet" href={`mailto:${contact.email}`}>{contact.email}</a></p>}
          {!contact.phone && !contact.email && (
            <p style="color: var(--text-soft); font-size: var(--fs-small)">
              Reach us on the <a class="link-quiet" href={href('/contact/')}>contact page</a> for now. A phone line and email arrive with opening.
            </p>
          )}
          {location.accessibilityNotes && (
            <p style="color: var(--text-soft); font-size: var(--fs-small)">{location.accessibilityNotes}</p>
          )}
        </div>
      </div>

      {location.mapEmbedUrl ? (
        <div class="frame" style="margin-top: var(--space-8); aspect-ratio: 21/9" data-reveal>
          <iframe
            src={location.mapEmbedUrl}
            title={`Map showing ${site.name}`}
            style="width:100%;height:100%;border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
      ) : (
        <div style="margin-top: var(--space-8); border: 1px dashed var(--line-strong); border-radius: var(--radius-l); padding: var(--space-8); text-align: center; color: var(--text-faint)" data-reveal>
          <p class="title-1" style="margin-bottom: var(--space-3)">A map arrives with the address</p>
          <p style="font-size: var(--fs-small)">A map and directions will appear here once the address is announced.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section--tight section" style="border-top: 1px solid var(--line)">
    <div class="container cta-band">
      <h2 class="title-1" data-reveal>Want to hear first?</h2>
      <div class="hero__cta" data-reveal style="--reveal-delay:100ms">
        <a class="btn btn--gold" href={order.href} {...(order.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
          {order.label} <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href={href('/contact/')}>Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>
