---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import ContactForm from '../components/ContactForm.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo.js';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Catering', path: '/catering/' },
];
---
<BaseLayout
  title="Catering & Events"
  description="Catering and event enquiries for Osthir Test — dum biryani, desi classics and traditional drinks for gatherings, offices and celebrations."
  jsonld={[breadcrumbJsonLd(crumbs)]}
>
  <header class="page-hero texture-leaf">
    <div class="container page-hero--split">
      <div class="page-hero__inner">
        <Breadcrumbs items={crumbs} />
        <p class="kicker" data-reveal>Catering & Events</p>
        <h1 class="display-hero" data-reveal style="--reveal-delay:100ms">The Pot Comes<br /><span class="serif-i gold">to You</span></h1>
        <p class="lede" data-reveal style="--reveal-delay:200ms">
          Dum biryani travels beautifully. Tell us about your gathering and we'll
          plan the spread with you.
        </p>
      </div>
      <div class="frame frame--wide" data-reveal="right">
        <Picture name="hero-table-spread" alt="A shared Osthir Test spread — biryani, korma and traditional drinks on brass trays" sizes="(min-width: 1024px) 45vw, 100vw" />
      </div>
    </div>
  </header>

  <section class="section--tight section">
    <div class="container">
      <div class="grid grid-3" style="margin-bottom: var(--space-8)">
        <div data-reveal style="border:1px solid var(--line);border-radius:var(--radius-l);padding:var(--space-6);display:grid;gap:var(--space-3);align-content:start">
          <h2 class="title-1" style="font-size:1.3rem">Family gatherings</h2>
          <p style="color:var(--text-soft);font-size:var(--fs-small)">Big handis of biryani, korma and desi classics, with teas and lassis to pour alongside.</p>
        </div>
        <div data-reveal style="--reveal-delay:120ms;border:1px solid var(--line);border-radius:var(--radius-l);padding:var(--space-6);display:grid;gap:var(--space-3);align-content:start">
          <h2 class="title-1" style="font-size:1.3rem">Office & team lunches</h2>
          <p style="color:var(--text-soft);font-size:var(--fs-small)">Generous, crowd-pleasing spreads that arrive steaming and disappear fast.</p>
        </div>
        <div data-reveal style="--reveal-delay:240ms;border:1px solid var(--line);border-radius:var(--radius-l);padding:var(--space-6);display:grid;gap:var(--space-3);align-content:start">
          <h2 class="title-1" style="font-size:1.3rem">Celebrations</h2>
          <p style="color:var(--text-soft);font-size:var(--fs-small)">The dough-sealed pot, opened at the table. A little theatre for your occasion.</p>
        </div>
      </div>

      <div class="split" style="align-items:start">
        <div class="split__text" data-reveal="left">
          <p class="kicker">Enquire</p>
          <h2 class="display-1" style="margin-top: var(--space-4)">Tell Us About<br /><span class="serif-i gold">Your Event</span></h2>
          <p class="lede" style="margin-top: var(--space-4)">
            Share the date, the headcount and what you're dreaming of. We'll come back
            with a menu and a plan.
          </p>
          <p style="margin-top: var(--space-5); font-size: var(--fs-small); color: var(--text-faint)">
            This form never claims a message was delivered unless it truly was — see
            the status note when you submit.
          </p>
        </div>
        <div class="split__media" data-reveal="right">
          <ContactForm id="catering-form" catering heading="Catering enquiry" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
