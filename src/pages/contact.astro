---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import site from '../config/site.js';
import { breadcrumbJsonLd, faqJsonLd } from '../lib/seo.js';
import { href } from '../lib/url.js';

const { contact } = site;
const order = site.orderingUrl;

const faqs = [
  {
    question: 'How do I order from Osthir Flavours?',
    answer: order
      ? 'Use the Order Online button anywhere on this site. It links to our ordering provider.'
      : 'Ordering opens with the restaurant. For now, browse the menu, and use this page or the Visit page to reach us.',
  },
  {
    question: 'What kind of food does Osthir Flavours serve?',
    answer: 'Dum-cooked beef and lamb biryani, desi classics (chicken, beef and duck curries), chicken korma, and traditional drinks, lemon, mint and saffron teas, lassis and pistachio badam milk.',
  },
  {
    question: 'Do you cater events?',
    answer: 'Yes, biryani and desi spreads travel well. Use the catering page to tell us about your event and we will plan the menu with you.',
  },
];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
---
<BaseLayout
  title="Contact"
  description="Contact Osthir Flavours, questions, feedback, catering and ordering enquiries."
  jsonld={[breadcrumbJsonLd(crumbs), faqJsonLd(faqs)]}
>
  <header class="page-hero texture-leaf">
    <div class="container page-hero__inner">
      <Breadcrumbs items={crumbs} />
      <p class="kicker" data-reveal>Contact</p>
      <h1 class="display-hero" data-reveal style="--reveal-delay:100ms">Say <span class="serif-i gold">Hello</span></h1>
      <p class="lede" data-reveal style="--reveal-delay:200ms">
        Questions, feedback, catering dreams, we read everything.
      </p>
    </div>
  </header>

  <section class="section--tight section">
    <div class="container split" style="align-items:start">
      <div class="split__text" data-reveal="left">
        <h2 class="title-1">Reach us directly</h2>
        <div style="display:grid;gap:var(--space-4);margin-top:var(--space-5)">
          {contact.email ? (
            <p><a class="link-quiet" href={`mailto:${contact.email}`}>{contact.email}</a></p>
          ) : (
            <p style="color:var(--text-soft);font-size:var(--fs-small)">Email is being connected and will appear here.</p>
          )}
          {contact.phone ? (
            <p><a class="link-quiet" href={`tel:${contact.phoneHref}`}>{contact.phone}</a></p>
          ) : (
            <p style="color:var(--text-soft);font-size:var(--fs-small)">Phone is being connected and will appear here.</p>
          )}
          <p style="color:var(--text-soft);font-size:var(--fs-small)">
            Planning a visit? The <a class="link-quiet" href={href('/locations/')}>Visit page</a> carries
            the address and opening hours once confirmed.
          </p>
        </div>

        <h2 class="title-1" style="margin-top:var(--space-8)">Quick answers</h2>
        <div style="margin-top: var(--space-5)">
          {faqs.map((f) => <Faq question={f.question}><p>{f.answer}</p></Faq>)}
        </div>
      </div>

      <div class="split__media" data-reveal="right">
        <ContactForm id="contact-form" heading="Contact Osthir Flavours" />
      </div>
    </div>
  </section>
</BaseLayout>
