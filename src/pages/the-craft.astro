---
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import VideoBlock from '../components/VideoBlock.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { craftChapters } from '../data/craft.js';
import { breadcrumbJsonLd } from '../lib/seo.js';
import { href } from '../lib/url.js';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'The Craft', path: '/the-craft/' },
];
---
<BaseLayout
  title="The craft"
  description="How a proper dum biryani is built, in eight steps: whole spices, fried onions, saffron, ghee, the dough seal, and the pours that finish the meal."
  jsonld={[breadcrumbJsonLd(crumbs)]}
>
  <header class="page-hero texture-leaf">
    <div class="container page-hero--split">
      <div class="page-hero__inner">
        <Breadcrumbs items={crumbs} />
        <p class="kicker" data-reveal>The Craft</p>
        <h1 class="display-hero" data-reveal style="--reveal-delay:100ms">Eight steps<br /><span class="serif-i gold">before the lid lifts</span></h1>
        <p class="lede" data-reveal style="--reveal-delay:200ms">
          This is how a proper dum biryani is made, step by step, from the mortar to
          the seal to the final pour.
        </p>
        <p style="margin-top: var(--space-4); font-size: var(--fs-micro); letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint)">Illustrative images</p>
      </div>
      <div class="frame frame--video" data-reveal="right">
        <VideoBlock name="biryani-pot-reveal" label="The lid of a golden biryani handi lifting to reveal steaming chicken biryani" />
      </div>
    </div>
  </header>

  <section class="section" aria-label="Craft chapters">
    <div class="container">
      {craftChapters.slice(0, 5).map((ch, i) => (
        <article class="chapter" aria-labelledby={`ch-${ch.id}`}>
          <div class="chapter__media" data-reveal={i % 2 ? 'right' : 'left'}>
            <div class="frame frame--wide clip-reveal">
              <Picture name={ch.image} alt={ch.alt} sizes="(min-width: 1024px) 55vw, 100vw" />
            </div>
          </div>
          <div class="chapter__text" data-reveal={i % 2 ? 'left' : 'right'}>
            <span class="chapter__num" aria-hidden="true">{ch.number}</span>
            <p class="kicker kicker--bare">{ch.kicker}</p>
            <h2 class="title-1" id={`ch-${ch.id}`}>{ch.title}</h2>
            <p style="color: var(--text-soft)">{ch.text}</p>
          </div>
        </article>
      ))}

      <div class="frame frame--video" style="margin-block: var(--space-8)" data-reveal>
        <VideoBlock name="curry-simmer" label="Chicken curry simmering gently in a copper pot, stirred with a ladle" />
      </div>

      {craftChapters.slice(5).map((ch, i) => (
        <article class="chapter" aria-labelledby={`ch-${ch.id}`}>
          <div class="chapter__media" data-reveal={i % 2 ? 'right' : 'left'}>
            <div class="frame frame--wide clip-reveal">
              <Picture name={ch.image} alt={ch.alt} sizes="(min-width: 1024px) 55vw, 100vw" />
            </div>
          </div>
          <div class="chapter__text" data-reveal={i % 2 ? 'left' : 'right'}>
            <span class="chapter__num" aria-hidden="true">{ch.number}</span>
            <p class="kicker kicker--bare">{ch.kicker}</p>
            <h2 class="title-1" id={`ch-${ch.id}`}>{ch.title}</h2>
            <p style="color: var(--text-soft)">{ch.text}</p>
          </div>
        </article>
      ))}

      <div class="cta-band" style="margin-top: var(--space-8)">
        <p class="kicker kicker--bare" data-reveal>The proof</p>
        <h2 class="display-1" data-reveal style="--reveal-delay:100ms">Now taste <span class="serif-i gold">the result</span></h2>
        <div class="hero__cta" data-reveal style="--reveal-delay:200ms">
          <a class="btn btn--gold" href={href('/menu/')}>See the menu <span class="btn__arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href={href('/our-story/')}>Our story</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
