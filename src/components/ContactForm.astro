---
import site from '../config/site.js';

// Honest enquiry form:
//  - Full client-side validation with accessible error messages.
//  - If site.forms.formEndpoint is configured → POSTs JSON, shows real
//    success/failure returned by the network call.
//  - Else if contact.email exists → opens the visitor's email app with a
//    pre-filled draft (mailto), and says so.
//  - Else → validates, then states clearly that online enquiries are not
//    connected yet. It NEVER pretends a message was delivered.
const {
  id = 'enquiry-form',
  catering = false,
  heading = 'Send an enquiry',
} = Astro.props;

const endpoint = site.forms.formEndpoint;
const email = site.contact.email;
---
<form
  class="form"
  id={id}
  novalidate
  data-endpoint={endpoint || undefined}
  data-email={email || undefined}
  data-catering={catering ? 'true' : undefined}
  aria-label={heading}
>
  <div class="form__row">
    <div class="field">
      <label for={`${id}-name`}>Name <span class="req" aria-hidden="true">*</span></label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required minlength="2" />
      <p class="field__error" id={`${id}-name-error`} aria-live="polite"></p>
    </div>
    <div class="field">
      <label for={`${id}-email`}>Email <span class="req" aria-hidden="true">*</span></label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
      <p class="field__error" id={`${id}-email-error`} aria-live="polite"></p>
    </div>
  </div>

  {catering && (
    <div class="form__row">
      <div class="field">
        <label for={`${id}-date`}>Event date</label>
        <input id={`${id}-date`} name="date" type="date" />
        <p class="field__error" aria-live="polite"></p>
      </div>
      <div class="field">
        <label for={`${id}-guests`}>Guests</label>
        <input id={`${id}-guests`} name="guests" type="number" min="1" max="2000" inputmode="numeric" />
        <p class="field__error" id={`${id}-guests-error`} aria-live="polite"></p>
      </div>
    </div>
  )}

  <div class="field">
    <label for={`${id}-message`}>{catering ? 'Tell us about your event' : 'Message'} <span class="req" aria-hidden="true">*</span></label>
    <textarea id={`${id}-message`} name="message" rows="5" required minlength="10"></textarea>
    <p class="field__error" id={`${id}-message-error`} aria-live="polite"></p>
  </div>

  <div class="form__status form__status--info" data-status role="status" aria-live="polite" hidden></div>

  <div>
    <button class="btn btn--gold" type="submit" data-submit>
      {catering ? 'Request catering' : 'Send message'} <span class="btn__arrow" aria-hidden="true">→</span>
    </button>
  </div>
</form>

<script>
  document.querySelectorAll('form.form[data-email], form.form[data-endpoint], form.form').forEach((form) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const status = form.querySelector('[data-status]');
    const submitBtn = form.querySelector('[data-submit]');

    const messages = {
      valueMissing: 'This field is required.',
      typeMismatch: 'Please enter a valid value (check the format).',
      tooShort: 'This is a little short, please add more detail.',
      rangeUnderflow: 'That number is too low.',
      rangeOverflow: 'That number is too high.',
    };

    function errorFor(input) {
      const v = input.validity;
      if (v.valid) return '';
      if (v.valueMissing) return messages.valueMissing;
      if (v.typeMismatch) return input.type === 'email' ? 'Please enter a valid email address.' : messages.typeMismatch;
      if (v.tooShort) return messages.tooShort;
      if (v.rangeUnderflow) return messages.rangeUnderflow;
      if (v.rangeOverflow) return messages.rangeOverflow;
      return 'Please check this field.';
    }

    function showStatus(kind, text) {
      if (!status) return;
      status.hidden = false;
      status.className = `form__status form__status--${kind}`;
      status.textContent = text;
    }

    function validateField(input) {
      const errEl = form.querySelector(`#${input.id}-error`);
      const msg = errorFor(input);
      input.setAttribute('aria-invalid', msg ? 'true' : 'false');
      if (errEl) errEl.textContent = msg;
      return !msg;
    }

    form.querySelectorAll('input, textarea').forEach((input) => {
      input.addEventListener('blur', () => validateField(input));
      input.addEventListener('input', () => {
        if (input.getAttribute('aria-invalid') === 'true') validateField(input);
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const inputs = [...form.querySelectorAll('input, textarea')];
      const allValid = inputs.map(validateField).every(Boolean);
      if (!allValid) {
        const firstInvalid = inputs.find((i) => i.getAttribute('aria-invalid') === 'true');
        firstInvalid?.focus();
        showStatus('err', 'Please fix the highlighted fields above.');
        return;
      }

      const data = Object.fromEntries(new FormData(form).entries());
      const endpoint = form.dataset.endpoint;
      const email = form.dataset.email;

      if (endpoint) {
        submitBtn?.setAttribute('disabled', '');
        showStatus('info', 'Sending your enquiry…');
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(data),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          showStatus('ok', 'Thank you, your enquiry has been sent. We will reply as soon as we can.');
          form.reset();
        } catch {
          showStatus('err', 'Sorry, the enquiry could not be sent. Please try again, or contact us directly.');
        } finally {
          submitBtn?.removeAttribute('disabled');
        }
      } else if (email) {
        const subject = encodeURIComponent(
          form.dataset.catering === 'true' ? `Catering enquiry from ${data.name}` : `Website enquiry from ${data.name}`,
        );
        const body = encodeURIComponent(
          Object.entries(data).map(([k, v]) => `${k}: ${v}`).join('\n'),
        );
        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
        showStatus('info', 'Opening your email app with a pre-filled message, press send there to reach us.');
      } else {
        showStatus(
          'info',
          'Thank you for your interest. Online enquiries are not connected yet, please check back soon, or see the Visit page for other ways to reach us.',
        );
      }
    });
  });
</script>
