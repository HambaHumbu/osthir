---
import '../styles/global.css';
import site from '../config/site.js';
import { canonical, restaurantJsonLd, websiteJsonLd } from '../lib/seo.js';
import { href, routePath } from '../lib/url.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatusBar from '../components/StatusBar.astro';
import SitePanels from '../components/SitePanels.astro';

const {
  title,
  description = site.description,
  image = site.seo.defaultOgImage,
  jsonld = [],
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonicalUrl = canonical(routePath(Astro.url.pathname));
const ogImage = site.url + href(image);
const ogLocale = site.locale.replace('-', '_');
const ogImageAlt = `${site.name}: Bengali biryani, desi curries and traditional drinks on brass trays`;
const schemas = [restaurantJsonLd(), websiteJsonLd(), ...jsonld];

// Self-hosted fonts live in public/fonts/. The @font-face rules are inline
// here (not in a bundled stylesheet) so url() can be prefixed with the
// configured base path (Vite does not rewrite public-dir paths in CSS).
const fontFaces = `@font-face {
  font-family: 'Fraunces';
  font-style: normal;
  font-weight: 300 700;
  font-display: swap;
  src: url('${href('/fonts/fraunces-var.woff2')}') format('woff2');
}
@font-face {
  font-family: 'Rany';
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url('${href('/fonts/rany-regular.woff2')}') format('woff2');
}
@font-face {
  font-family: 'Rany';
  font-style: normal;
  font-weight: 500;
  font-display: swap;
  src: url('${href('/fonts/rany-medium.woff2')}') format('woff2');
}
@font-face {
  font-family: 'Rany';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('${href('/fonts/rany-bold.woff2')}') format('woff2');
}`;
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={site.seo.themeColor} />
    {site.seo.googleSiteVerification && <meta name="google-site-verification" content={site.seo.googleSiteVerification} />}
    {site.seo.bingSiteVerification && <meta name="msvalidate.01" content={site.seo.bingSiteVerification} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" type="image/png" sizes="32x32" href={href('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />

    <link rel="preload" href={href('/fonts/fraunces-var.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={href('/fonts/rany-regular.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <StatusBar />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SitePanels />

    <button class="to-top" type="button" aria-label="Back to top" hidden>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M8 13V3M3 7.5 8 2.5l5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <script>
      // Scroll reveals via IntersectionObserver, disabled under reduced motion.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealEls = document.querySelectorAll('[data-reveal], .clip-reveal');
      if (reduced) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.01, rootMargin: '0px 0px 8% 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // Back-to-top
      const toTop = document.querySelector('.to-top');
      if (toTop) {
        const onScroll = () => {
          const show = window.scrollY > 900;
          toTop.classList.toggle('is-visible', show);
          toTop.hidden = !show && !toTop.classList.contains('is-visible');
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        toTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' }));
      }
    </script>
  </body>
</html>
